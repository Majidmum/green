# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ТОЛЬКО серверная сторона. Никогда не добавляйте префикс NEXT_PUBLIC_
# и не импортируйте в клиентские компоненты.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Публичный адрес сайта (для sitemap, Open Graph, ссылок восстановления пароля)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Необязательно: Telegram-уведомления о новых заказах
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
